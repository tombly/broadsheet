<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Broadsheet.Ui"
             xmlns:dash="clr-namespace:Broadsheet.Dashboard;assembly=Broadsheet.Dashboard"
             x:Class="Broadsheet.Ui.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type dash:BroadsheetApp}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
